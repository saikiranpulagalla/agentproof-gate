# Copy this file to .env.arena and replace every REQUIRED value.
# Node >=20.11 loads it through --env-file; do not commit .env.arena.

PORT=8787
REQUIRE_SHAREDOS=true

# REQUIRED: exact organizer-issued SharedOS tenant/namespace.
AGENTPROOF_NAMESPACE=
# REQUIRED: exact organizer-issued SharedOS owner address JSON.
# Example shape only; replace the entire value:
# AGENTPROOF_OWNER_ADDRESS_JSON={"kind":"human","userId":"..."}
AGENTPROOF_OWNER_ADDRESS_JSON=
AGENTPROOF_PURPOSE=agentproof-verify-before-commit

MAX_CONCURRENCY=6
MAX_QUEUE=6
MAX_INFLIGHT_PER_CALLER=2
REQUEST_TIMEOUT_MS=45000
TURN_TIMEOUT_MS=18000
IDEMPOTENCY_TTL_MS=600000
IDEMPOTENCY_MAX_ENTRIES=500
MAX_CALLS_PER_CALLER_PER_MIN=24
AGENTPROOF_AUDIT_LOG=./data/audit.ndjson

# REQUIRED: module implementing the organizer-provided SharedOS Cloud audit sink.
SHAREDOS_AUDIT_SINK_MODULE=./arena-audit.js
ORGANIZER_AUDIT_TIMEOUT_MS=3000
ORGANIZER_AUDIT_INIT_TIMEOUT_MS=5000

# REQUIRED: production semantic critic.
CRITIC_PROVIDER=llm
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=12000
LLM_MAX_TOKENS=1200

# REQUIRED: node ID assigned when your personal agent is registered on SharedNet.
SHAREDNET_NODE_ID=
# REQUIRED: commit-safe organizer integration implementing registerService + callService.
SHAREDNET_ADAPTER_MODULE=./sharednet-arena.js
SHAREDNET_INIT_TIMEOUT_MS=8000

# REQUIRED: public repository URL actually submitted to Devpost; must match git remote origin.
SUBMISSION_REPO_URL=
