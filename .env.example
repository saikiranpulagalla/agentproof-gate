PORT=8787
REQUIRE_SHAREDOS=true
AGENTPROOF_NAMESPACE=agentproof-arena
AGENTPROOF_OWNER_ID=arena-owner
# Prefer the exact owner address supplied by #arena-support, for example:
# AGENTPROOF_OWNER_ADDRESS_JSON={"kind":"human","userId":"..."}
AGENTPROOF_PURPOSE=agentproof-verify-before-commit
MAX_CONCURRENCY=6
MAX_QUEUE=6
MAX_INFLIGHT_PER_CALLER=2
REQUEST_TIMEOUT_MS=45000
TURN_TIMEOUT_MS=18000
IDEMPOTENCY_TTL_MS=600000
IDEMPOTENCY_MAX_ENTRIES=500
MAX_CALLS_PER_CALLER_PER_MIN=24
AGENTPROOF_AUDIT_LOG=./data/audit.ndjson
# Module containing the organizer-provided SharedOS Cloud audit sink.
# SHAREDOS_AUDIT_SINK_MODULE=./arena-audit.js
ORGANIZER_AUDIT_TIMEOUT_MS=3000

# Arena: use llm so a missing model configuration fails at startup.
# For local no-key smoke testing only, change this to deterministic.
CRITIC_PROVIDER=llm
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=12000
LLM_MAX_TOKENS=1200

# Assigned when your personal agent is registered on SharedNet.
SHAREDNET_NODE_ID=
